{
	"name": "flarum-lang/spanish",
	"description": "Spanish Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/spanish",
	"license": "MIT",
	"authors": [
		{
			"name": "iamdarkle",
			"homepage": "https://github.com/iamdarkle",
			"role": "Maintainer"
		},
		{
			"name": "jslirola",
			"homepage": "https://github.com/jslirola",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/spanish/issues",
		"forum": "https://discuss.flarum.org/d/26792",
		"source": "https://github.com/flarum-lang/spanish"
	},
	"require": {
		"flarum/core": "^2.0",
		"flarum-lang/utils": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Spanish",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#fff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "es",
			"title": "Español"
		}
	}
}
